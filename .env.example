# ÍRIS — exemplo de variáveis de ambiente.
# Copie para .env (na RAIZ do repo) e preencha. NUNCA versione o .env.
# Regra ARKHEN: segredos fora do código, senhas fortes e únicas, rotação periódica.
# Suba a stack com:  docker compose --env-file ../.env -f infra/docker-compose.yml up -d

# =========================================================
# Domínio (troque pelo real; use os subdomínios iris. e bi.)
# =========================================================
# Ex.: SEU_DOMINIO=arkhentecnologia.com.br  -> iris.arkhentecnologia.com.br / bi.arkhentecnologia.com.br

# --- PostgreSQL do negócio (iris) ---
APP_DB_NAME=iris
APP_DB_OWNER=iris_owner            # dono: roda migrações (DDL)
APP_DB_OWNER_PWD=
APP_DB_APP_USER=iris_app           # usado pelo n8n (DML, sem DDL) — criado na Fase 1
APP_DB_APP_PWD=
APP_DB_RO_USER=iris_ro             # somente leitura (fonte de dados do Metabase) — criado na Fase 1
APP_DB_RO_PWD=

# --- PostgreSQL do n8n (isolado) ---
N8N_DB_NAME=n8n
N8N_DB_USER=n8n_user
N8N_DB_PWD=

# --- PostgreSQL do Metabase (metadados do próprio Metabase) ---
MB_DB_NAME=metabase
MB_DB_USER=metabase
MB_DB_PWD=

# --- n8n ---
N8N_ENCRYPTION_KEY=                # gere uma chave forte (ex.: openssl rand -hex 32) e guarde com segurança
N8N_HOST=iris.SEU_DOMINIO
N8N_WEBHOOK_URL=https://iris.SEU_DOMINIO/

# --- Caixa de e-mail (IMAP leitura / SMTP envio) — senha de app (2FA) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=contato@SEU_DOMINIO
IMAP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=contato@SEU_DOMINIO
SMTP_APP_PASSWORD=

# --- Provedor de IA (PD-03: Vertex AI x OpenAI — decisão pendente) ---
IA_PROVIDER=                       # vertex | openai
IA_API_KEY=
IA_MODEL=

# --- Observabilidade ---
SENTRY_DSN=
